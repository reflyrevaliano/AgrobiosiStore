{
  "expo": {
    "name": "AgrobioStore",
    "slug": "agrobiostore-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "agrobiostore",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.agrobiostore.demo"
    },
    "ios": {
      "bundleIdentifier": "com.agrobiostore.demo"
    }
  }
}
